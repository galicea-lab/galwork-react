{
  "name": "@galicea-lab/react-accessibility-toolbar",
  "version": "0.1.1",
  "description": "Reusable, configurable accessibility toolbar component (font size, high contrast, collapse) for React applications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galicea-lab/galwork-react.git",
    "directory": "packages/react-accessibility-toolbar"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node scripts/build.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  },
 "publishConfig": {
    "access": "public"
  }
}
